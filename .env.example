# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Format: KEY=VALUE, no quotes, no spaces around "=".
#
# Services read this file themselves (spring.config.import in each application.properties) when started from the
# repo root or from a service folder; Docker Compose reads it automatically; real environment variables win over it.

# ---- Shared secret (HS256, at least 32 characters; identical for every service) ----
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# ---- PostgreSQL (one database per service) ----
AUTH_DB_URL=jdbc:postgresql://localhost:5432/turf_auth
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=change-me
TURF_DB_URL=jdbc:postgresql://localhost:5432/turf_service
TURF_DB_USERNAME=postgres
TURF_DB_PASSWORD=change-me
OWNER_DB_URL=jdbc:postgresql://localhost:5432/turf_owner
OWNER_DB_USERNAME=postgres
OWNER_DB_PASSWORD=change-me
BOOKING_DB_URL=jdbc:postgresql://localhost:5432/turf_booking
BOOKING_DB_USERNAME=postgres
BOOKING_DB_PASSWORD=change-me

# ---- RabbitMQ connection (docker-compose.yml also uses the username/password to create the broker's user) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=turf
RABBITMQ_PASSWORD=change-me

# ---- RabbitMQ names (must be the same in every service that uses them; change only all together) ----
# auth-service -> owner-service
AUTH_EVENTS_EXCHANGE=auth.events
OWNER_REGISTERED_KEY=owner.registered
OWNER_REGISTERED_QUEUE=owner-service.owner-registered
OWNER_REGISTERED_DLQ=owner-service.owner-registered.dlq
# owner-service -> turf-service
OWNER_EVENTS_EXCHANGE=owner.events
VERIFICATION_CHANGED_KEY=owner.verification.changed
VERIFICATION_QUEUE=turf-service.owner-verification
VERIFICATION_DLQ=turf-service.owner-verification.dlq
# booking-service -> turf-service (commands) and back (replies)
BOOKING_COMMANDS_EXCHANGE=booking.commands
TURF_EVENTS_EXCHANGE=turf.events
COMMAND_QUEUE=turf-service.booking-commands
COMMAND_DLQ=turf-service.booking-commands.dlq
REPLY_QUEUE=booking-service.turf-replies
REPLY_DLQ=booking-service.turf-replies.dlq
RESERVE_KEY=slots.reserve
CONFIRM_KEY=slots.confirm
RELEASE_KEY=slots.release
RESERVED_KEY=slots.reserved
REJECTED_KEY=slots.rejected
RELEASED_KEY=slots.released

# ---- Ports ----
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8080
TURF_SERVICE_PORT=8082
OWNER_SERVICE_PORT=8083
BOOKING_SERVICE_PORT=8084

# ---- Service URLs (used by the gateway, and by turf-/booking-service to reach owner-service) ----
AUTH_SERVICE_URL=http://localhost:8080
TURF_SERVICE_URL=http://localhost:8082
OWNER_SERVICE_URL=http://localhost:8083
BOOKING_SERVICE_URL=http://localhost:8084

# ---- Gateway CORS: comma-separated origins of your frontend ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- First admin account (optional; the account is only created when both email and password are set) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# ADMIN_PHONE=+910000000000
